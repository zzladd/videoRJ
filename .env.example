# ============ 基础 ============
# 数据目录（素材、帧、成片等都存这里）
DATA_DIR=./data
# 数据库连接串（默认 SQLite，SaaS 化可换 PostgreSQL）
DATABASE_URL=sqlite:///./data/app.db

# ============ 多租户 / 鉴权（SaaS 预留）============
# 留空 = 不鉴权（自用模式，所有请求归 default 租户）
# 格式: api_key:tenant_id 逗号分隔，例如 sk-abc:alice,sk-def:bob
API_KEYS=

# ============ 任务执行 ============
# inline = 进程内线程池（自用）; celery = 分布式队列（SaaS）
TASK_BACKEND=inline
TASK_WORKERS=2
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ============ LLM（脚本生成）============
# mock = 无需 API Key 的内置规则生成（调试用）; openai = OpenAI 兼容接口
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ============ ASR（语音转写）============
# none = 跳过; faster_whisper = 本地模型; openai = OpenAI 兼容 /audio/transcriptions
ASR_PROVIDER=none
ASR_WHISPER_MODEL=small
ASR_API_BASE_URL=https://api.openai.com/v1
ASR_API_KEY=
ASR_API_MODEL=whisper-1

# ============ OCR（画面文字识别）============
# none = 跳过; rapidocr = 本地 OCR
OCR_PROVIDER=none

# ============ 链接下载 ============
# 抖音部分内容需要登录 Cookie 才能下载。
# 用浏览器插件（如 Get cookies.txt LOCALLY）导出 Netscape 格式 cookies.txt 后填写路径
YTDLP_COOKIES_FILE=

# ============ 视频处理 ============
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
# 分析时统一转码的最长边
TRANSCODE_MAX_EDGE=1280
# 场景切分阈值 (0~1，越小切得越碎)
SCENE_THRESHOLD=0.35
# 抽帧间隔（秒）
FRAME_INTERVAL=2.0
